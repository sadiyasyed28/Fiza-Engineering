# Contact Form Delivery Configuration
# At least one of RESEND_API_KEY or FORMSPREE_FORM_ID is required for the contact form to work.

# Resend API Key for sending emails directly
RESEND_API_KEY=

# Formspree Form ID as a fallback/alternative service
FORMSPREE_FORM_ID=

# The email address that will receive the contact form submissions
CONTACT_NOTIFICATION_EMAIL=
